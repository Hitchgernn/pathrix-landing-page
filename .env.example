# Copy to .env.local and fill in. All three are unresolved placeholders in the
# design; see the "Still unresolved" section of AGENTS.md before shipping.

# Real WebGIS URL for the "Jelajahi Peta" / "Buka peta" CTAs.
# Falls back to "#fitur", which is a placeholder, not a destination.
VITE_MAP_URL=

# Public contact address. Falls back to halo@pathrix.id, which is a placeholder
# and has not been confirmed.
VITE_CONTACT_EMAIL=

# Contact form endpoint. Receives JSON { nama, kontak, pesan } via POST.
# When empty the form composes a mailto: instead — it never fakes success.
VITE_CONTACT_ENDPOINT=

# Absolute origin (no trailing slash), e.g. https://pathrix.id — used to build
# absolute hreflang alternates between / and /en/. Search engines don't credit
# relative hreflang hrefs. Read directly by scripts/prerender.mjs via
# process.env, not by the client bundle, so it does not need the VITE_ prefix
# to work — kept for naming symmetry with the other three.
# When empty, prerender falls back to root-relative hrefs and logs a warning.
VITE_SITE_URL=
