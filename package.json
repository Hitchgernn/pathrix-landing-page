{
  "name": "pathrix-landingpage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "images": "bash scripts/encode-images.sh",
    "verify": "node scripts/verify.mjs",
    "verify:pause": "node scripts/check-pause.mjs",
    "verify:weight": "node scripts/weight-check.mjs",
    "verify:framing": "node scripts/framing-check.mjs",
    "verify:vehicles": "node scripts/vehicle-check.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.12.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.49.1",
    "typescript": "5.6.3",
    "vite": "^5.4.21"
  }
}
